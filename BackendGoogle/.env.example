# Google Gemini API Key
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Optional: For ngrok tunnel (if needed for public access)
NGROK_AUTH_TOKEN=
NGROK_DOMAIN=

# SAM2 segmentation server (required for segmentation)
# Self-host with sam2_server.py, then point this at it
SAM2_SERVER_URL=http://localhost:8666

# Extra CORS origins for a deployed frontend (comma-separated, optional)
# ALLOWED_ORIGINS=https://your-frontend.example.com
